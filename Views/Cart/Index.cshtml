@model List<entasp.Models.CartItem>

@{
    ViewData["Title"] = "Cart";
}

<h1>Shopping Cart</h1>

@if (Model.Count == 0)
{
    <p>Your cart is empty.</p>

    <a asp-controller="Products"
       asp-action="Index"
       class="btn btn-primary">
        Go to Products
    </a>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>₱@item.Price.ToString("0.00")</td>

                    <td>
                        <form asp-action="Update"
                              method="post"
                              class="d-flex">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <input type="number"
                                   name="quantity"
                                   value="@item.Quantity"
                                   min="1"
                                   class="form-control"
                                   style="width: 80px;" />

                            <button type="submit"
                                    class="btn btn-sm btn-primary ms-2">
                                Update
                            </button>
                        </form>
                    </td>

                    <td>
                        ₱@((item.Price * item.Quantity).ToString("0.00"))
                    </td>

                    <td>
                        <a asp-action="Remove"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-danger"
                           onclick="return confirm('Remove this item?')">
                            Remove
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="text-end">
        Total:
        ₱@Model.Sum(x => x.Price * x.Quantity).ToString("0.00")
    </h4>
}