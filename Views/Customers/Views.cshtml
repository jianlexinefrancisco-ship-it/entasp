@model entasp.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<h1>Customer Details</h1>

<div class="card">
    <div class="card-body">

        <h4>@Model.CustomerName</h4>

        <hr />

        <p>
            <strong>ID:</strong>
            @Model.Id
        </p>

        <p>
            <strong>Customer Name:</strong>
            @Model.CustomerName
        </p>

        <p>
            <strong>Contact Name:</strong>
            @Model.ContactName
        </p>

        <p>
            <strong>Email:</strong>
            @Model.Email
        </p>

        <p>
            <strong>Phone:</strong>
            @Model.Phone
        </p>

        <p>
            <strong>Address:</strong>
            @Model.Address
        </p>

        <p>
            <strong>City:</strong>
            @Model.City
        </p>

        <p>
            <strong>State:</strong>
            @Model.State
        </p>

        <p>
            <strong>Zip Code:</strong>
            @Model.ZipCode
        </p>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>
</div>