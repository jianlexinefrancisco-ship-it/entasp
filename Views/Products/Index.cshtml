@model List<entasp.Models.Product>

@{
    ViewData["Title"] = "Menu";
}

<h1>Menu</h1>

<form asp-action="Index" method="get" class="mb-3">
    <input type="text"
           name="searchString"
           value="@ViewData["searchString"]"
           placeholder="Search product name..."
           class="form-control d-inline-block"
           style="width: 250px;" />

    <button type="submit" class="btn btn-primary">
        Search
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Clear
    </a>
</form>

<a asp-action="Create" class="btn btn-success mb-4">
    + Add Product
</a>

<div class="row">
    @foreach (var p in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card product-card shadow-sm">
                <div class="card-body">

                    <h5 class="card-title">
                        @p.Name
                    </h5>

                    <p class="card-text">
                        @p.Description
                    </p>

                    <p class="mb-1">
                        <strong>Price:</strong>
                        ₱@p.Price.ToString("0.00")
                    </p>

                    <p class="mb-3">
                        <strong>Category:</strong>
                        @p.Category
                    </p>

                    <div class="card-actions">

                        <a asp-action="Edit"
                           asp-route-id="@p.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@p.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Delete this product?')">
                            Delete
                        </a>

                        <a asp-action="AddToCart"
                           asp-route-id="@p.Id"
                           class="btn btn-success btn-sm mt-2 w-100">
                            Add to Cart
                        </a>

                    </div>

                </div>
            </div>
        </div>
    }
</div>